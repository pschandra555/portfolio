# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Never prefix these with NEXT_PUBLIC_: they must stay server-side.

# "Interrogate the file" AI chat (free key: https://console.groq.com/keys).
# Without it, the chat uses pre-written answers generated from content/site.ts.
GROQ_API_KEY=
# Optional. Any Groq chat model id; defaults to openai/gpt-oss-20b.
GROQ_MODEL=
# Optional. Max live answers per day across all visitors (protects the free tier). Default 500.
INTERROGATE_DAILY_CAP=

# Optional. Shared rate limiting across serverless instances (free tier at upstash.com).
# Without these, rate limits are kept in memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
